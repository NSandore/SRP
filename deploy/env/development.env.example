# Copy to /home/nick/.config/srp/development.env and chmod 0600.
# Never commit the populated file.
APP_BASE_URL=http://127.0.0.1:3000
DB_HOST=localhost
DB_NAME=srp_db_dev
DB_USER=srp_dev_user
DB_PASS=replace-with-a-random-development-password
SRP_DEV_MODE=true
DISABLE_TWO_FACTOR=true
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
APP_ENCRYPTION_KEY=replace-with-a-separate-development-key

# Add development-only mail/provider credentials only when a feature needs
# them. Do not reuse production credentials by default.
