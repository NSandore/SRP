# Copy to /home/nick/.config/srp/production.env and chmod 0600.
# Never commit the populated file.
APP_BASE_URL=https://thestudentsphere.com
DB_HOST=localhost
DB_NAME=srp_db
DB_USER=srp_user
DB_PASS=replace-with-the-production-database-password
SRP_DEV_MODE=false
DISABLE_TWO_FACTOR=false
APP_ENCRYPTION_KEY=replace-with-the-production-encryption-key

